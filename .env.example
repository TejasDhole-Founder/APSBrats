# Copy to .env and fill in. Never commit the real .env.
DB_USER=aps_user
DB_PASSWORD=change-me-to-something-strong
# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
# Dev convenience OTP. MUST be blank in production.
OTP_MASTER=000000

# Sign-in codes by email (Brevo). Leave unset locally: the code is printed in the API log.
# BREVO_API_KEY must be a Brevo API key (v3); EMAIL_SENDER_ADDRESS must be a sender
# verified in Brevo. Check it: GET /api/v1/admin/email/health (ADMIN account).
# BREVO_API_KEY=
# EMAIL_SENDER_ADDRESS=no-reply@apsbrats.com
# EMAIL_SENDER_NAME=APS Brats

# Media storage. Leave unset for local disk (fine for dev/compose).
# Set STORAGE_TYPE=r2 for Cloud Run or any environment with no persistent disk —
# see docs/DEPLOYMENT.md "Media storage (Cloudflare R2)" for how to create these.
# STORAGE_TYPE=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=apsbrats-media
# MEDIA_BASE_URL=https://media.apsbrats.com
